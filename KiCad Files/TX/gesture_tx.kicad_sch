(text "GESTURE TX rev A - schematic reconstructed from Gerber copper/drill/silkscreen.\nPower: J2 BAT+ -> TP4056 B+ ; TP4056 O+ -> SW1 pin3 ; SW1 pin2 -> BOOST I+ ; BOOST O+ (5V) -> ESP32 5V + C1.\nI2C: BNO055 SDA = IO21, SCL = IO22, powered from ESP32 3V3. SW1 pin1 unused." (at 40 25 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "b52f8f9f-adeb-4b4f-aa23-2d3c564a4b32"))
 (sheet_instances (path "/" (page "1")))
